# Server configuration
PORT=3000
NODE_ENV=development

# Session secret (provide a strong random string in production)
SESSION_SECRET=deadlinedeck_development_secret_change_in_production

# MySQL Database configuration (Option A: Individual parameters)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=deadlinedeck
DB_CONNECTION_LIMIT=10
DB_SSL=false

# MySQL Database configuration (Option B: Single connection URL for Railway, Render, etc.)
# DATABASE_URL=mysql://username:password@hostname:3306/deadlinedeck
